# Default: let git auto-detect text vs binary, normalize to LF.
* text=auto eol=lf

# Files that MUST be LF on disk regardless of platform — failing the
# eol on any of these silently breaks behaviour:
#   - shell scripts: CRLF makes bash report "command not found" on the
#     shebang line and on every other line
#   - YAML: GitHub Actions can choke on CRLF in some cases
#   - Makefiles: tabs are significant; CRLF can corrupt rule indentation
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf
*.make      text eol=lf

# Source code files — keep as LF for consistency with the rest of the
# Python/C ecosystem; CI runs on Linux which expects LF.
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf

# Binary files — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.so        binary
*.dylib     binary
*.dll       binary
*.a         binary
*.o         binary
*.npy       binary
*.npz       binary
*.pkl       binary
*.csv       binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary
*.zip       binary
*.whl       binary
*.pem       binary
